#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
	[ -x /usr/lib/nava/core/sing-box ] || return 1
	[ -s /etc/nava/config.json ] || return 1
	mkdir -p /var/run/nava
	chmod 700 /var/run/nava
	/usr/bin/python3 /usr/lib/nava/network_cleanup.py prepare-start || return 1
	/usr/bin/python3 /usr/lib/nava/dns_forwarding.py reset || return 1
	procd_open_instance core
	procd_set_param command /usr/lib/nava/core/sing-box run -c /etc/nava/config.json
	procd_set_param user root
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/nava/config.json
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
	if /usr/bin/python3 /usr/lib/nava/dns_forwarding.py needed; then
		local dns_generation
		dns_generation="$(/usr/bin/python3 /usr/lib/nava/dns_forwarding.py arm)" || return 1
		procd_open_instance dns
		procd_set_param command /usr/bin/python3 /usr/lib/nava/dns_forwarding.py watch "$dns_generation"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param term_timeout 35
		procd_close_instance
	fi
}

stop_service() {
	# Invalidate the watcher first, without restarting dnsmasq under live NFT.
	/usr/bin/python3 /usr/lib/nava/dns_forwarding.py arm >/dev/null
	/usr/bin/python3 /usr/lib/nava/network_cleanup.py begin-stop
}

service_stopped() {
	local result=0
	/usr/bin/python3 /usr/lib/nava/network_cleanup.py cleanup || result=1
	/usr/bin/python3 /usr/lib/nava/dns_forwarding.py reset || result=1
	return "$result"
}

reload_service() {
	# Only restart an active instance when firewall/network configuration changes.
	procd_running nava && restart
}

service_triggers() {
	procd_add_reload_trigger firewall network
}
